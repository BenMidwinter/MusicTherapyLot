---
const pathname = Astro.url.pathname;

const links = [
  { href: '/process-based-music-therapy', label: 'Process-Based Music Therapy' },
  { href: '/therapy', label: 'Therapy' },
  { href: '/consulting', label: 'Consulting' },
  { href: '/supervision', label: 'Supervision' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: 'https://secat.app/', label: 'SECAT®', external: true },
];

const isCurrent = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-logo" href="/">
      <img src="/logo-nav.png" alt="" width="40" height="40" />
      <span>That Music Therapy Lot</span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Primary">
      {
        links.map((link) =>
          link.external ? (
            <a href={link.href} rel="noopener noreferrer" target="_blank">
              {link.label}
            </a>
          ) : (
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          )
        )
      }
      <a class="nav-cta" href="/#contact">Contact</a>
    </nav>
  </div>
</header>
