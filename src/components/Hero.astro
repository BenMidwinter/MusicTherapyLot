---
---

<section class="hero hero--photo" id="top" aria-labelledby="hero-brand">
  <img
    class="hero__media"
    src="/images/web/PianoInRoom.jpg"
    alt="A black grand piano in a bright therapy room with green walls and natural light in Walthamstow, London"
    width="2400"
    height="1350"
    fetchpriority="high"
  />
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__content">
    <h1 class="hero__brand" id="hero-brand">That Music Therapy Lot</h1>
    <p class="hero__line">
      Process-Based Music Therapy and SEND consultation in Walthamstow, London,
      E17 — where words fail, music speaks.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/therapy">Therapy for you</a>
      <a class="btn btn--ghost btn--on-photo" href="/consulting">Consulting</a>
    </div>
  </div>
</section>
